<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CheckmkDesktopNotifier.App.MacOS"
        x:Class="CheckmkDesktopNotifier.App.MacOS.ProblemPanelWindow"
        x:DataType="vm:MacProblemListViewModel"
        Title="Checkmk Desktop Notifier"
        Width="520"
        Height="640"
        MinWidth="420"
        MinHeight="460"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="Full"
        Topmost="True">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       Text="Problems" />
            <TextBlock Margin="10,0,0,0" Classes="muted" VerticalAlignment="Center"
                       Text="{Binding ConnectionLabel}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Foreground="{DynamicResource CdnCrit}"
                   Text="{Binding ErrorText}"
                   IsVisible="{Binding HasError}"
                   TextWrapping="Wrap" />

        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Grid.Column="0" Classes="cdn-secondary" Content="Settings" Margin="0,0,8,0"
                    Command="{Binding OpenSettingsCommand}" />
            <Button Grid.Column="1" Classes="cdn-secondary" Content="Open Checkmk"
                    Command="{Binding OpenSiteCommand}" />
            <Button Grid.Column="3" Classes="cdn-secondary" Content="Quit"
                    Command="{Binding QuitCommand}" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <WrapPanel>
                <ToggleButton Classes="filter-chip" Margin="0,0,6,6"
                              Content="{Binding FilterAllLabel}"
                              IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                              Command="{Binding SelectAllFilterCommand}" />
                <ToggleButton Classes="filter-chip" Margin="0,0,6,6"
                              Content="{Binding FilterNewLabel}"
                              IsChecked="{Binding IsFilterNew, Mode=OneWay}"
                              Command="{Binding SelectNewFilterCommand}" />
                <ToggleButton Classes="filter-chip" Margin="0,0,6,6"
                              Content="{Binding FilterCriticalLabel}"
                              IsChecked="{Binding IsFilterCritical, Mode=OneWay}"
                              Command="{Binding SelectCriticalFilterCommand}" />
                <ToggleButton Classes="filter-chip" Margin="0,0,6,6"
                              Content="{Binding FilterWarningLabel}"
                              IsChecked="{Binding IsFilterWarning, Mode=OneWay}"
                              Command="{Binding SelectWarningFilterCommand}" />
                <ToggleButton Classes="filter-chip" Margin="0,0,6,6"
                              Content="{Binding FilterUnknownLabel}"
                              IsChecked="{Binding IsFilterUnknown, Mode=OneWay}"
                              Command="{Binding SelectUnknownFilterCommand}" />
                <ToggleButton Classes="filter-chip" Margin="0,0,6,6"
                              Content="{Binding FilterTakenLabel}"
                              IsChecked="{Binding IsFilterTaken, Mode=OneWay}"
                              Command="{Binding SelectTakenFilterCommand}" />
            </WrapPanel>
            <TextBox Watermark="Search host, service, Taken-by"
                     Text="{Binding SearchText}" />
        </StackPanel>

        <Panel>
            <TextBlock Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding HasEmptyText}"
                       Margin="4,16" />
            <ScrollViewer IsVisible="{Binding HasRows}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MacProblemRowViewModel">
                            <Border Classes="cdn-card">
                                <Grid ColumnDefinitions="6,*">
                                    <Border Grid.Column="0" CornerRadius="3"
                                            Background="{DynamicResource CdnCrit}"
                                            IsVisible="{Binding IsCritical}" />
                                    <Border Grid.Column="0" CornerRadius="3"
                                            Background="{DynamicResource CdnWarn}"
                                            IsVisible="{Binding IsWarning}" />
                                    <Border Grid.Column="0" CornerRadius="3"
                                            Background="{DynamicResource CdnUnk}"
                                            IsVisible="{Binding IsUnknown}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Classes="badge-crit"
                                                    IsVisible="{Binding IsCritical}">
                                                <TextBlock Classes="badge-text" Text="{Binding SeverityText}" />
                                            </Border>
                                            <Border DockPanel.Dock="Right" Classes="badge-warn"
                                                    IsVisible="{Binding IsWarning}">
                                                <TextBlock Classes="badge-text" Text="{Binding SeverityText}" />
                                            </Border>
                                            <Border DockPanel.Dock="Right" Classes="badge-unk"
                                                    IsVisible="{Binding IsUnknown}">
                                                <TextBlock Classes="badge-text" Text="{Binding SeverityText}" />
                                            </Border>
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding HostDisplay}" />
                                        </DockPanel>
                                        <TextBlock Opacity="0.92" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ServiceDisplay}" />
                                        <TextBlock Classes="muted" FontSize="12" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding SummaryDisplay}" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Classes="badge-new" Margin="0,0,6,4"
                                                    IsVisible="{Binding IsNew}">
                                                <TextBlock Classes="badge-text" Text="NEW" />
                                            </Border>
                                            <Border Background="{DynamicResource CdnCardBackground}"
                                                    BorderBrush="{DynamicResource CdnBorder}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="6,2" Margin="0,0,6,4"
                                                    IsVisible="{Binding IsSeen}">
                                                <TextBlock FontSize="11" Text="Seen" />
                                            </Border>
                                            <Button Classes="badge-taken" Margin="0,0,6,4"
                                                    Content="{Binding TakeStateText}"
                                                    Command="{Binding ReleaseCommand}"
                                                    IsVisible="{Binding CanRelease}"
                                                    ToolTip.Tip="Release this Checkmk Desktop Notifier take" />
                                            <Border Classes="badge-taken" Margin="0,0,6,4"
                                                    IsVisible="{Binding ShowTakenBadge}">
                                                <TextBlock Classes="badge-text"
                                                           Text="{Binding TakeStateText}" />
                                            </Border>
                                            <Border Classes="badge-ack" Margin="0,0,6,4"
                                                    IsVisible="{Binding ShowAck}">
                                                <TextBlock Classes="badge-text" Text="ACK" />
                                            </Border>
                                            <TextBlock Classes="muted" FontSize="12" Margin="0,0,6,4"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding TakeStateText}"
                                                       IsVisible="{Binding ShowTaking}" />
                                            <TextBlock Classes="muted" FontSize="12" Margin="0,0,6,4"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding TakeStateText}"
                                                       IsVisible="{Binding ShowReleasing}" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <Button Classes="cdn-secondary" Margin="0,0,6,0"
                                                    Content="{Binding ToggleSeenLabel}"
                                                    Command="{Binding ToggleSeenCommand}" />
                                            <Button Classes="cdn-primary" Margin="0,0,6,0"
                                                    Content="{Binding TakeButtonText}"
                                                    Command="{Binding TakeCommand}"
                                                    IsVisible="{Binding ShowTake}" />
                                            <Button Classes="cdn-secondary"
                                                    Content="Open in Checkmk"
                                                    Command="{Binding OpenInCheckmkCommand}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</Window>
