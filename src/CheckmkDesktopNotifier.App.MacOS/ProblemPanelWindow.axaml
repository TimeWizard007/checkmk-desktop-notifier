<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CheckmkDesktopNotifier.App.MacOS"
        x:Class="CheckmkDesktopNotifier.App.MacOS.ProblemPanelWindow"
        x:DataType="vm:MacProblemListViewModel"
        Title="Checkmk Desktop Notifier"
        Width="420"
        Height="560"
        MinWidth="360"
        MinHeight="420"
        CanResize="True"
        ShowInTaskbar="False"
        SystemDecorations="BorderOnly"
        Topmost="True">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                       Text="Problems" />
            <TextBlock Margin="10,0,0,0" Opacity="0.75" VerticalAlignment="Center"
                       Text="{Binding ConnectionLabel}" />
        </DockPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0" ColumnDefinitions="Auto,Auto,*,Auto">
            <Button Grid.Column="0" Content="Settings" Margin="0,0,6,0"
                    Command="{Binding OpenSettingsCommand}" />
            <Button Grid.Column="1" Content="Open Checkmk"
                    Command="{Binding OpenSiteCommand}" />
            <Button Grid.Column="3" Content="Quit"
                    Command="{Binding QuitCommand}" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <ToggleButton Content="ALL" IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                              Command="{Binding SelectAllFilterCommand}" />
                <ToggleButton Content="NEW" IsChecked="{Binding IsFilterNew, Mode=OneWay}"
                              Command="{Binding SelectNewFilterCommand}" />
                <ToggleButton Content="CRIT" IsChecked="{Binding IsFilterCritical, Mode=OneWay}"
                              Command="{Binding SelectCriticalFilterCommand}" />
                <ToggleButton Content="WARN" IsChecked="{Binding IsFilterWarning, Mode=OneWay}"
                              Command="{Binding SelectWarningFilterCommand}" />
                <ToggleButton Content="UNK" IsChecked="{Binding IsFilterUnknown, Mode=OneWay}"
                              Command="{Binding SelectUnknownFilterCommand}" />
                <ToggleButton Content="TAKEN" IsChecked="{Binding IsFilterTaken, Mode=OneWay}"
                              Command="{Binding SelectTakenFilterCommand}" />
            </StackPanel>
            <TextBox Watermark="Search host, service, Taken-by"
                     Text="{Binding SearchText}" />
        </StackPanel>

        <Panel>
            <TextBlock Text="{Binding EmptyText}" Opacity="0.7" TextWrapping="Wrap"
                       IsVisible="{Binding HasEmptyText}"
                       Margin="4,12" />
            <ListBox ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MacProblemRowViewModel">
                        <Border Padding="8,6" CornerRadius="6" Margin="0,0,0,6">
                            <StackPanel Spacing="2">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold"
                                               Text="{Binding SeverityText}" />
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Text="{Binding HostName}" />
                                </DockPanel>
                                <TextBlock Opacity="0.9" TextTrimming="CharacterEllipsis"
                                           Text="{Binding ServiceName}" />
                                <TextBlock Opacity="0.75" FontSize="12" TextWrapping="Wrap"
                                           Text="{Binding Summary}" />
                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock FontSize="12" Text="{Binding SeenLabel}" />
                                        <TextBlock FontSize="12" Opacity="0.85"
                                                   Text="{Binding TakeStateText}" />
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                                HorizontalAlignment="Right">
                                        <Button Content="{Binding ToggleSeenLabel}"
                                                Command="{Binding ToggleSeenCommand}" />
                                        <Button Content="Open in Checkmk"
                                                Command="{Binding OpenInCheckmkCommand}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </DockPanel>
</Window>
