<Application x:Class="CheckmkDesktopNotifier.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CheckmkDesktopNotifier.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E2228"/>
        <SolidColorBrush x:Key="BarBackgroundBrush" Color="#252A33"/>
        <SolidColorBrush x:Key="BarBorderBrush" Color="#3A4150"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2"/>
        <SolidColorBrush x:Key="NewAccentBrush" Color="#C62828"/>
        <SolidColorBrush x:Key="NewAccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CriticalBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F9A825"/>
        <SolidColorBrush x:Key="UnknownBrush" Color="#AB47BC"/>
        <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#3A4150"/>
        <SolidColorBrush x:Key="RowBackgroundBrush" Color="#2B313C"/>
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3A4150"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility"/>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrush"/>

        <Style x:Key="BarTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BarTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BadgeBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
    </Application.Resources>
</Application>
