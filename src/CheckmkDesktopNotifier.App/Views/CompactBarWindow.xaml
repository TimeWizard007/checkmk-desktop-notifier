<Window x:Class="CheckmkDesktopNotifier.App.Views.CompactBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Text.CompactBarTitle}"
        Height="36"
        SizeToContent="Width"
        MinWidth="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{StaticResource BarBackgroundBrush}"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseLeftButtonUp"
        Cursor="SizeAll">
    <Border BorderBrush="{StaticResource BarBorderBrush}" BorderThickness="1" Padding="10,0">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource BarTextStyle}"
                       FontWeight="SemiBold"
                       Text="{Binding Text.CompactBarTitle}"/>
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="  |  "/>

            <Border x:Name="NewSegment" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNewProblems}" Value="True">
                                <Setter Property="Background" Value="{StaticResource NewAccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BarTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNewProblems}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource NewAccentTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding Text.NewLabel, Mode=OneWay}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding NewCount, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedTextStyle}" Text=" | "/>
            <TextBlock Style="{StaticResource BarTextStyle}">
                <Run Text="{Binding Text.CriticalLabel, Mode=OneWay}"/>
                <Run Text=": "/>
                <Run Text="{Binding CriticalCount, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MutedTextStyle}" Text=" | "/>
            <TextBlock Style="{StaticResource BarTextStyle}">
                <Run Text="{Binding Text.WarningLabel, Mode=OneWay}"/>
                <Run Text=": "/>
                <Run Text="{Binding WarningCount, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MutedTextStyle}" Text=" | "/>
            <TextBlock Style="{StaticResource BarTextStyle}">
                <Run Text="{Binding Text.UnknownLabel, Mode=OneWay}"/>
                <Run Text=": "/>
                <Run Text="{Binding UnknownCount, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource MutedTextStyle}" Text=" | "/>
            <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding ConnectionStatusText, Mode=OneWay}"/>
            <TextBlock Style="{StaticResource MutedTextStyle}" Text=" | "/>
            <TextBlock Style="{StaticResource MutedTextStyle}">
                <Run Text="{Binding Text.LastCheckLabel, Mode=OneWay}"/>
                <Run Text=": "/>
                <Run Text="{Binding LastCheckText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
