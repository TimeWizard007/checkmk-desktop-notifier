<Window x:Class="CheckmkDesktopNotifier.App.Views.TakeConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        Background="{StaticResource WindowBackgroundBrush}"
        BorderBrush="{StaticResource BarBorderBrush}"
        BorderThickness="0"
        Icon="pack://application:,,,/Assets/app.ico"
        FocusManager.FocusedElement="{Binding ElementName=ConfirmButton}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource BarBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource WindowBackgroundBrush}">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource BarBackgroundBrush}"
                    BorderBrush="{StaticResource BarBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <TextBlock FontFamily="Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding Title}"/>
            </Border>
            <StackPanel Margin="16">
                <TextBlock FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="18"
                           Text="{Binding Body}"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button x:Name="CancelButton"
                            MinWidth="88"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding Cancel}"
                            IsCancel="True"
                            Click="OnCancelClick"
                            Visibility="{Binding ShowCancel, Converter={StaticResource BooleanToVisibility}}"/>
                    <Button x:Name="ConfirmButton"
                            MinWidth="88"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{Binding Confirm}"
                            IsDefault="True"
                            Click="OnConfirmClick"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
