<Window x:Class="CheckmkDesktopNotifier.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="{Binding Text.SettingsTitle}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource RowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource RowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BarBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="DarkOptionRadio" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <Ellipse Stroke="{StaticResource BarBorderBrush}" StrokeThickness="1" Fill="{StaticResource RowBackgroundBrush}"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource TextBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource RowBackgroundBrush}"
                                    BorderBrush="{StaticResource BarBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Path x:Name="Mark"
                                      Data="M2,7 L6,11 L14,3"
                                      Stroke="{StaticResource TextBrush}"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Stretch="Uniform"
                                      Margin="2"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSliderRepeat" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSliderThumb" TargetType="primitives:Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Ellipse Fill="{StaticResource TextBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    Background="{StaticResource BarBorderBrush}"
                                    CornerRadius="2"
                                    Margin="7,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DarkSliderRepeat}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <primitives:Thumb Style="{StaticResource DarkSliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource DarkSliderRepeat}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <TabControl>
        <TabItem Header="{Binding Text.SettingsTabGeneral}">
            <StackPanel>
                <CheckBox Style="{StaticResource DarkCheckBox}"
                          Content="{Binding Text.SettingsStartWithWindows}"
                          IsChecked="{Binding StartWithWindows}"/>
                <TextBlock Text="{Binding AutostartStatusText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource CriticalBrush}"
                           FontSize="11"
                           Margin="0,8,0,0"
                           Visibility="{Binding HasAutostartStatus, Converter={StaticResource BooleanToVisibility}}"/>
                <TextBlock FontWeight="SemiBold"
                           Margin="0,16,0,8"
                           Text="{Binding Text.TeamCoordination}"/>
                <CheckBox Style="{StaticResource DarkCheckBox}"
                          Content="{Binding Text.EnableTake}"
                          IsChecked="{Binding EnableTake}"/>
                <Grid Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="{Binding Text.DisplayName}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding TakeDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <TextBlock Text="{Binding Text.TeamCoordinationHint}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="{Binding Text.SettingsTabConnection}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="{Binding Text.SettingsServerUrl}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="{Binding Text.SettingsSite}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Site, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="{Binding Text.SettingsUsername}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,12,0"
                               Text="{Binding Text.SettingsSecret}"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                        <PasswordBox x:Name="SecretBox"/>
                        <TextBlock Text="{Binding Text.SettingsSecretHint}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding HasStoredSecret, Converter={StaticResource BooleanToVisibility}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="{Binding Text.SettingsPollInterval}"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Width="88" HorizontalAlignment="Left"
                             Text="{Binding PollIntervalText, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,10,0,10"
                           MinHeight="20"/>

                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding Text.SettingsTestConnection}"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding CanInteract}"/>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0"
                            Content="{Binding Text.SettingsSave}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanInteract}"/>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"
                            Content="{Binding Text.SettingsCancel}"
                            Command="{Binding CancelCommand}"/>
                </DockPanel>

                <Border BorderBrush="{StaticResource BarBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,10,0,0">
                    <Button Style="{StaticResource ResetButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0"
                            Content="{Binding Text.SettingsReset}"
                            Click="OnResetClick"
                            IsEnabled="{Binding CanInteract}"/>
                </Border>
            </StackPanel>
        </TabItem>
        <TabItem Header="{Binding Text.SettingsTabNotifications}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="{Binding Text.SoundSection}"/>
                <RadioButton GroupName="NotificationSound"
                             Style="{StaticResource DarkOptionRadio}"
                             Content="{Binding Text.SoundDefault}"
                             IsChecked="{Binding IsDefaultSound, Mode=OneWay}"
                             Command="{Binding SelectDefaultSoundCommand}"/>
                <RadioButton GroupName="NotificationSound"
                             Style="{StaticResource DarkOptionRadio}"
                             Content="{Binding Text.SoundCustomWav}"
                             IsChecked="{Binding IsCustomSound, Mode=OneWay}"
                             Command="{Binding SelectCustomSoundCommand}"/>
                <StackPanel Margin="24,0,0,10">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Content="{Binding Text.SoundChooseWav}"
                            Command="{Binding ChooseCustomWavCommand}"/>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Text="{Binding CustomSoundDisplayName}"
                               Visibility="{Binding HasCustomSoundName, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>
                <TextBlock Text="{Binding SoundStatusText}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource CriticalBrush}"
                           FontSize="11"
                           Margin="0,0,0,8"
                           Visibility="{Binding HasSoundStatus, Converter={StaticResource BooleanToVisibility}}"/>

                <TextBlock FontWeight="SemiBold" Margin="0,4,0,8" Text="{Binding Text.SoundVolume}"/>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right"
                               MinWidth="36"
                               TextAlignment="Right"
                               Text="{Binding VolumePercentText}"/>
                    <Slider Style="{StaticResource DarkSlider}"
                            Value="{Binding VolumePercent, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <Button Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8"
                        Content="{Binding Text.TestNotificationSound}"
                        Command="{Binding TestNotificationSoundCommand}"/>
                <Button Style="{StaticResource ResetButtonStyle}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Content="{Binding Text.SoundRestoreDefault}"
                        Command="{Binding RestoreDefaultSoundCommand}"/>
                <CheckBox Style="{StaticResource DarkCheckBox}"
                          Content="{Binding Text.SoundMute}"
                          IsChecked="{Binding MuteSound}"
                          Visibility="{Binding ShowMuteToggle, Converter={StaticResource BooleanToVisibility}}"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
